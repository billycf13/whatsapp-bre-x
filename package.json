{
  "name": "whatsapp-bre-x",
  "version": "1.0.0",
  "description": "WhatsApp Business REST Engine - Multi Session WhatsApp API with Baileys",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "db:validate": "npx prisma validate --config=./prisma.config.ts",
    "db:generate": "npx prisma generate --config=./prisma.config.ts",
    "db:migrate": "npx prisma migrate dev --config=./prisma.config.ts"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-api",
    "baileys",
    "multi-session",
    "typescript",
    "rest-api"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.7.6",
    "@prisma/client": "^7.2.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/socket.io": "^3.0.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}